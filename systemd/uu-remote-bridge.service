[Unit]
Description=UU Remote bridge for the live GNOME desktop
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-%h/.config/uu-remote-bridge/environment
ExecStart=%h/.local/bin/uu-remote-bridge
# A clean child/signal exit is still an outage; systemctl stop remains final.
Restart=always
RestartSec=30
TimeoutStopSec=15
KillMode=control-group
LimitNOFILE=65536
# WebView2 on a 4K desktop sits around 4 GiB. A 3 GiB MemoryHigh
# throttles the UI thread until GNOME reports the window as not responding.
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=8G
TasksMax=4096
OOMPolicy=stop

[Install]
WantedBy=default.target
